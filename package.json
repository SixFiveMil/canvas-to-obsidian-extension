{
  "name": "canvas-to-obsidian-extension",
  "version": "0.4.1",
  "license": "MIT",
  "description": "Browser extension that extracts Canvas LMS course content from an active session and forwards to Obsidian.",
  "author": "Joshua A. Wortz <security@codeandcypher.com> (https://github.com/SixFiveMil)",
  "repository": {
    "type": "git",
    "url": "https://github.com/SixFiveMil/canvas-to-obsidian-extension.git"
  },
  "homepage": "https://codeandcypher.com/projects",
  "bugs": {
    "url": "https://github.com/SixFiveMil/canvas-to-obsidian-extension/issues"
  },
  "keywords": [
    "canvas-lms",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "obsidian",
    "education"
  ],
  "scripts": {
    "build": "node build.mjs all",
    "build:all": "node build.mjs all",
    "build:chrome": "node build.mjs chrome",
    "build:firefox": "node build.mjs firefox",
    "package": "node scripts/package.mjs all",
    "package:all": "node scripts/package.mjs all",
    "package:chrome": "node scripts/package.mjs chrome",
    "package:firefox": "node scripts/package.mjs firefox",
    "validate": "node scripts/validate-dist.mjs all",
    "validate:chrome": "node scripts/validate-dist.mjs chrome",
    "validate:firefox": "node scripts/validate-dist.mjs firefox",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "lint": "npm run lint:firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bridge": "node scripts/test-bridge.mjs",
    "typecheck": "tsc --noEmit",
    "publish:stores": "node scripts/publish-stores.mjs all",
    "publish:cws": "node scripts/publish-stores.mjs chrome",
    "publish:amo": "node scripts/publish-stores.mjs firefox",
    "version": "node scripts/sync-version.mjs",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.315",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "jszip": "^3.10.1",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4",
    "web-ext": "^8.10.0"
  }
}
